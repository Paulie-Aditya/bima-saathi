# ---- Agora (console.agora.io: project with App Certificate + Conversational AI enabled) ----
AGORA_APP_ID=
AGORA_APP_CERT=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGENT_RTC_UID=1001

# ---- ASR: Sarvam (hi-IN, or "unknown" for auto-detect) ----
SARVAM_API_KEY=
ASR_LANGUAGE=hi-IN

# ---- TTS: Murf Falcon (pick an Indian voice that supports hi-IN + en-IN) ----
MURF_API_KEY=
MURF_VOICE_ID=
MURF_VOICE_ID_KN=
MURF_MODEL=FALCON
MURF_LOCALE=hi-IN
# MURF_BASE_URL=wss://global.api.murf.ai/v1/speech/stream-input

# ---- LLM: any OpenAI-compatible endpoint with tool calling ----
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
# Agora sends this as "Authorization: Bearer <secret>" to /chat/completions
LLM_SHARED_SECRET=change-me

# Public HTTPS URL Agora calls (tunnel or deployed server), and where the web app lives
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
WEB_BASE_URL=http://localhost:3000

# ---- Telegram: @BotFather token; chat ids of the demo phone and the claims-desk group ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEMO_CHAT_ID=
TELEGRAM_DESK_CHAT_ID=

# ---- Google Calendar: service account (path or inline JSON) shared on the demo calendar ----
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# ---- MVP+ flags (start values; flip at runtime on /admin) ----
FEATURE_RAG=1
FEATURE_CALLBACK=1
FEATURE_DOCS=1
FEATURE_KANNADA=1
